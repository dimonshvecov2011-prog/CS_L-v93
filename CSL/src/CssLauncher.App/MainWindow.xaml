<Window x:Class="CssLauncher.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CS:L" Height="760" Width="1180" MinHeight="650" MinWidth="980" WindowStartupLocation="CenterScreen" Background="#0A0F1E" Foreground="#F4F7FF"><Window.Resources><SolidColorBrush x:Key="PanelBrush" Color="#121A2D"/><SolidColorBrush x:Key="Panel2Brush" Color="#17223A"/><SolidColorBrush x:Key="MutedBrush" Color="#8C9AB5"/><SolidColorBrush x:Key="AccentBrush" Color="#6DE4FF"/><SolidColorBrush x:Key="PurpleBrush" Color="#9B7BFF"/><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#F4F7FF"/></Style><Style TargetType="Button"><Setter Property="FontFamily" Value="Segoe UI Semibold"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#F4F7FF"/><Setter Property="Background" Value="#243252"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#33466F"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Style><Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#3B82F6"/><Setter Property="FontSize" Value="16"/><Setter Property="Padding" Value="24,13"/></Style><Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#13B8D4"/><Setter Property="Foreground" Value="#06111D"/><Setter Property="FontSize" Value="15"/><Setter Property="Padding" Value="18,11"/></Style><Style TargetType="TextBox"><Setter Property="Background" Value="#0E1628"/><Setter Property="Foreground" Value="#F4F7FF"/><Setter Property="BorderBrush" Value="#2A3A5E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/></Style><Style TargetType="ComboBox"><Setter Property="Background" Value="#0E1628"/><Setter Property="Foreground" Value="#F4F7FF"/><Setter Property="BorderBrush" Value="#2A3A5E"/><Setter Property="Padding" Value="8,6"/></Style><Style TargetType="CheckBox"><Setter Property="Foreground" Value="#C8D3E8"/><Setter Property="Margin" Value="0,0,18,0"/></Style></Window.Resources><Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="20"><DockPanel><StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="0,4,0,32"><Border Width="42" Height="42" CornerRadius="12" Background="#243B72"><TextBlock Text="CS" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="CS:L" FontSize="25" FontWeight="Bold"/><TextBlock Text="SOURCE LAUNCHER" FontSize="9" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/></StackPanel></StackPanel><TextBlock Text="НАВИГАЦИЯ" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" Margin="4,0,0,12"/><Button Content="  Обзор" HorizontalContentAlignment="Left" Background="#243B72"/><Button Content="  Моды" HorizontalContentAlignment="Left" Background="Transparent"/><Button Content="  Настройки" HorizontalContentAlignment="Left" Background="Transparent"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><Border Background="#0E1628" CornerRadius="12" Padding="12" Margin="0,0,0,12"><StackPanel><TextBlock Text="CS:S STATUS" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SideStatusText" Text="Не подключено" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="SideVersionText" Text="—" FontSize="11" Foreground="{StaticResource AccentBrush}"/></StackPanel></Border><TextBlock Text="CS:L v0.2.0" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel></DockPanel></Border><Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Grid.Row="0" Margin="0,0,0,22"><TextBlock Text="Добро пожаловать в CS:L" FontSize="30" FontWeight="Bold"/><TextBlock Text="Твой быстрый и чистый запуск Counter-Strike: Source" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="22" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ИГРА" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/><TextBlock x:Name="StatusText" Text="Ищем Counter-Strike: Source..." FontSize="21" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBlock x:Name="PathText" Text="Укажите папку или установите игру через Steam" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="BuildText" Text="ClientVersion: —   •   Steam buildid: —" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="InstallButton" Content="Установить через Steam" Click="InstallGame_Click" Style="{StaticResource AccentButton}"/><Button Content="Выбрать папку" Click="ChooseFolder_Click"/></StackPanel></Grid></Border><Grid Grid.Row="2" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="20"><StackPanel><TextBlock Text="МОДЫ" FontSize="11" Foreground="{StaticResource PurpleBrush}" FontWeight="Bold"/><TextBlock Text="Твой набор готов к запуску" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,2"/><TextBlock Text="Менеджер модов подключим следующим модулем. Профиль и custom уже готовы." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/><Button Content="Открыть папку модов" Click="OpenMods_Click" HorizontalAlignment="Left"/></StackPanel></Border><Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="20"><StackPanel><TextBlock Text="ПРОФИЛЬ" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/><TextBlock Text="default" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,2"/><TextBlock Text="Изолированный профиль CS:L, оригинальные файлы Steam не трогаем." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/><Button Content="Открыть профиль" Click="OpenProfile_Click" HorizontalAlignment="Left"/></StackPanel></Border></Grid><Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="20"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="ПАРАМЕТРЫ ЗАПУСКА" FontSize="11" Foreground="{StaticResource MutedBrush}" FontWeight="Bold"/><CheckBox x:Name="DiagnosticBox" Content="Диагностический режим" Checked="DiagnosticChanged" Unchecked="DiagnosticChanged" Margin="24,0,0,0"/></StackPanel><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,16"><CheckBox x:Name="SteamBox" Content="-steam" IsChecked="True"/><CheckBox x:Name="NovidBox" Content="-novid" IsChecked="True"/><CheckBox x:Name="ConsoleBox" Content="-console" IsChecked="True"/><CheckBox x:Name="WindowedBox" Content="-windowed"/><CheckBox x:Name="NoborderBox" Content="-noborder"/><TextBlock Text="exe:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="6,0,6,0"/><ComboBox x:Name="ExecutableBox" Width="130" SelectedIndex="0"><ComboBoxItem Content="cstrike.exe"/><ComboBoxItem Content="hl2.exe"/></ComboBox></WrapPanel><TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Background="#0A1020" BorderThickness="0" Foreground="#9EB1D0"/></DockPanel></Border><StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><TextBlock x:Name="HintText" Text="Готов к запуску" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,18,0"/><Button x:Name="PlayButton" Content="ИГРАТЬ  ›" Click="Play_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}"/></StackPanel></Grid></Grid></Window>
