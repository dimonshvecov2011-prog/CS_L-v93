<Window x:Class="CssLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CS:L 0.3.6-rc2" Height="760" Width="1200" MinHeight="460" MinWidth="760"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="#0A101A" Foreground="#EEF4FF">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="12" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#0A101A" />
        <SolidColorBrush x:Key="PanelBrush" Color="#111B2A" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#162337" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#26374D" />
        <SolidColorBrush x:Key="TextBrush" Color="#EEF4FF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#96A7BD" />
        <SolidColorBrush x:Key="AccentBrush" Color="#55D6C2" />
        <SolidColorBrush x:Key="BlueBrush" Color="#5C9DFF" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F5BE6B" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,9" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#20334A" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#476582" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#263D55" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.48" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#07131A" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#0C1421" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#0C1421" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#C9D5E5" />
            <Setter Property="Margin" Value="0,0,14,6" />
            <Setter Property="Padding" Value="2,2" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#142236" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#17283A" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="#0D1725" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7" />
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#16253A" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1B3545" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="7" Background="{StaticResource CanvasBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0F1927" BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,0,0,1" CornerRadius="11,11,0,0">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"
                                MouseLeftButtonDown="WindowHeader_MouseLeftButtonDown"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Width="30" Height="30" CornerRadius="9" Background="#173846">
                            <TextBlock Text="CS" Foreground="{StaticResource AccentBrush}" FontSize="12"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CS:L" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="SOURCE LAUNCHER" FontSize="8" Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="COUNTER-STRIKE: SOURCE  /  COMMUNITY CLIENT"
                               Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="24,0,0,0"
                               MouseLeftButtonDown="WindowHeader_MouseLeftButtonDown"
                               shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Content="—" Style="{StaticResource CaptionButton}" Click="MinimizeWindow_Click"
                                ToolTip="Свернуть" AutomationProperties.Name="Свернуть окно"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource CaptionButton}"
                                Click="MaximizeWindow_Click" ToolTip="Развернуть" AutomationProperties.Name="Развернуть окно"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Content="×" Style="{StaticResource CaptionButton}" Click="CloseWindow_Click"
                                ToolTip="Закрыть" AutomationProperties.Name="Закрыть лаунчер"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="176" />
                    <ColumnDefinition x:Name="SidebarGapColumn" Width="13" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="SidebarPanel" Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1" CornerRadius="12" Padding="13">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Top" Background="#142336" CornerRadius="10" Padding="11" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="ИГРОВАЯ СБОРКА" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="CS:S v93" FontSize="19" FontWeight="Bold" Margin="0,5,0,1" />
                                <TextBlock Text="Поддерживаемая версия клиента" FontSize="10"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <StackPanel DockPanel.Dock="Bottom">
                            <TextBlock x:Name="LauncherVersionText" Text="CS:L v0.3.6-rc2" FontSize="10"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                            <TextBlock Text="CS:L не изменяет файлы Steam и запускает официальную установку."
                                       FontSize="9" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="СОСТОЯНИЕ ИГРЫ" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" Margin="2,2,0,7" />
                            <Border Background="#0C1420" BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1" CornerRadius="9" Padding="10">
                                <StackPanel>
                                    <TextBlock x:Name="SideStatusText" Text="Не подключено" FontSize="12"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="SideVersionText" Text="—" FontSize="10"
                                               Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="УСТАНОВКА ИГРЫ" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" Margin="2,17,0,7" />
                            <TextBlock Text="Игра устанавливается официальным клиентом Steam. CS:L не копирует и не изменяет игровые файлы."
                                       FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="GameActionsColumn" Width="158" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="БИБЛИОТЕКА" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock x:Name="StatusText" Text="Ищем Counter-Strike: Source..." FontSize="17"
                                           FontWeight="SemiBold" Margin="0,4,0,1" TextWrapping="Wrap" />
                                <TextBlock x:Name="PathText" Text="Укажите папку или установите игру через Steam"
                                           Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" />
                                <TextBlock x:Name="BuildText" Text="ClientVersion: —   •   Steam buildid: —"
                                           Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,6,0,0"
                                           TextWrapping="Wrap" />
                                <StackPanel x:Name="ExecutablePanel" Orientation="Horizontal" Margin="0,6,0,0"
                                            Visibility="Collapsed">
                                    <TextBlock Text="Запускать:" Foreground="{StaticResource MutedBrush}"
                                               FontSize="10" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <ComboBox x:Name="ExecutableBox" Width="125" SelectionChanged="ExecutableChanged" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button x:Name="InstallButton" Click="InstallGame_Click"
                                        Background="{StaticResource AccentBrush}" Foreground="#07131A"
                                        Margin="0,0,0,6" Padding="9,8" FontSize="11">
                                    <TextBlock Text="Установить через Steam" TextWrapping="Wrap" TextAlignment="Center" />
                                </Button>
                                <Button x:Name="ChooseFolderButton" Content="Выбрать папку" Click="ChooseFolder_Click" Margin="0,0,0,6"
                                        Padding="9,8" FontSize="11" />
                                <Button x:Name="RetryInstallButton" Content="Проверить снова" Click="RetryInstall_Click"
                                        Visibility="Collapsed" Margin="0" Padding="9,8" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TabControl x:Name="MainTabs" Grid.Row="1" Margin="0,0,0,9">
                        <TabItem Header="Обзор">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="3,10,5,8">
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="ЗАПУСК CS:S" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="Официальные файлы игры без копирования и подмены gameinfo.txt"
                                                       FontSize="14" FontWeight="SemiBold" Margin="0,5,0,3" TextWrapping="Wrap" />
                                            <TextBlock Text="Лаунчер запускает выбранный exe напрямую с официальным cstrike/gameinfo.txt. Настройки запуска сохраняются отдельно."
                                                       Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                                                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                                                CornerRadius="12" Padding="13">
                                            <StackPanel>
                                                <TextBlock Text="ПАРАМЕТРЫ ЗАПУСКА" FontSize="9" FontWeight="Bold"
                                                           Foreground="{StaticResource BlueBrush}" />
                                                <TextBlock Text="Обычный запуск игры" FontSize="14"
                                                           FontWeight="SemiBold" Margin="0,5,0,3" TextWrapping="Wrap" />
                                                <TextBlock Text="Флажки запуска находятся в нижней панели. CS:L не копирует и не изменяет файлы Steam."
                                                           Foreground="{StaticResource MutedBrush}" FontSize="10"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="{StaticResource PanelBrush}"
                                                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                                                CornerRadius="12" Padding="13">
                                            <StackPanel>
                                                <TextBlock Text="ОБНОВЛЕНИЕ ЛАУНЧЕРА" FontSize="9" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock x:Name="UpdateStatusText" Text="Проверка не выполнялась"
                                                           FontSize="13" FontWeight="SemiBold" Margin="0,5,0,2"
                                                           TextWrapping="Wrap" />
                                                <Button x:Name="CheckUpdateButton" Content="Проверить обновления" Click="CheckUpdate_Click"
                                                        HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,7"
                                                        FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Серверы">
                            <Grid Margin="3,10,5,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1" CornerRadius="10" Padding="9" Margin="0,0,0,8">
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBox x:Name="ServerSourceBox" Width="250" Text="config/servers.example.json"
                                                 ToolTip="Путь к JSON-файлу или HTTPS-ссылка" Margin="0,0,7,5" />
                                        <Button Content="Обновить список" Click="LoadServers_Click"
                                                Margin="0,0,0,5" Padding="10,7" FontSize="11" />
                                    </WrapPanel>
                                </Border>
                                <ListView x:Name="ServersList" Grid.Row="1" Margin="0,0,0,8">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="10"
                                                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Address}" FontSize="10"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="ServerDetailText" Grid.Row="2" FontSize="10"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="Диагностика">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="3,10,5,8">
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1" CornerRadius="12" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="ДИАГНОСТИЧЕСКИЙ АРХИВ" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="Соберите материалы для поиска проблемы" FontSize="15"
                                                       FontWeight="SemiBold" Margin="0,5,0,6" TextWrapping="Wrap" />
                                            <TextBlock Text="ZIP включает настройки и логи CS:L, а также отдельные сведения о версии Steam. Игровые файлы Valve в архив не добавляются. Перед отправкой откройте архив и проверьте, что он не содержит нежелательных личных данных."
                                                       Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" />
                                            <Button x:Name="CreateDiagnosticButton" Content="Создать ZIP-архив"
                                                    Click="CreateDiagnostic_Click" HorizontalAlignment="Left"
                                                    Margin="0,12,0,0" />
                                            <TextBlock x:Name="DiagnosticStatusText" Foreground="{StaticResource MutedBrush}"
                                                       FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="RecoveryTab" Header="Восстановление">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="3,10,5,8">
                                    <Border x:Name="RecoveryNotice" Background="#3A2D18" BorderBrush="#80602E"
                                            BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="RecoveryNoticeText" TextWrapping="Wrap" FontSize="11" />
                                    </Border>
                                    <Border x:Name="SafeModeNotice" Background="#3A2D18" BorderBrush="#80602E"
                                            BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10"
                                            Visibility="Collapsed">
                                        <TextBlock Text="Безопасный режим: игра, автообнаружение и сетевые обновления отключены. Используйте действия восстановления, затем перезапустите CS:L без --safe-mode."
                                                   TextWrapping="Wrap" FontSize="11" />
                                    </Border>
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="РЕЗЕРВНЫЕ КОПИИ НАСТРОЕК" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="Хранятся последние пять версий settings.json. Перед восстановлением текущие данные также сохраняются."
                                                       FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,7" />
                                            <ListView x:Name="SettingsBackupsList" Height="105">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding CreatedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss} UTC}" FontSize="10" />
                                                            <TextBlock Text="{Binding SizeBytes, StringFormat={}{0:N0} bytes}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                            <Button x:Name="RestoreSettingsButton" Content="Восстановить выбранную копию"
                                                    Click="RestoreSettings_Click" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1" CornerRadius="12" Padding="13">
                                        <StackPanel>
                                            <TextBlock Text="ВОССТАНОВЛЕНИЕ ПОСЛЕ СБОЯ" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource WarningBrush}" />
                                            <TextBlock Text="Аварийное завершение фиксируется маркером. Диагностический архив содержит список доступных резервных копий, но не включает содержимое всех бэкапов."
                                                       FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,8" />
                                            <WrapPanel>
                                                <Button Content="Создать диагностический архив" Click="CreateDiagnostic_Click" />
                                                <Button Content="Сбросить настройки CS:L" Click="ResetEverything_Click"
                                                        Background="#4A2C2C" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1" CornerRadius="12" Padding="11">
                        <StackPanel>
                            <WrapPanel>
                                <CheckBox x:Name="DiagnosticBox" Content="Диагностический режим"
                                          Checked="DiagnosticChanged" Unchecked="DiagnosticChanged" />
                                <CheckBox x:Name="SteamBox" Content="-steam" IsChecked="True" />
                                <CheckBox x:Name="NovidBox" Content="-novid" IsChecked="True" />
                                <CheckBox x:Name="ConsoleBox" Content="-console" IsChecked="True" />
                            </WrapPanel>
                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="HintText" Text="Готов к запуску" Foreground="{StaticResource MutedBrush}"
                                           FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Margin="1,0,8,0" />
                                <Button x:Name="PlayButton" Grid.Column="1" Content="ИГРАТЬ  ›"
                                        Click="Play_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}"
                                        MinWidth="128" Margin="0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
